  },
  "items": [
    {
      "info": {
        "name": "concept",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List concepts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coactive.ai/api/v1/concepts",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "datasets",
                "value": "",
                "type": "query",
                "description": "Datasets to use to filter concepts"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Starting index to return"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Max number of items to return"
              }
            ]
          },
          "docs": "Get paginated concepts, optionally filtered by datasets"
        },
        {
          "info": {
            "name": "Create concept",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.coactive.ai/api/v1/concepts",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new concept"
        },
        {
          "info": {
            "name": "Get concept",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coactive.ai/api/v1/concepts/:concept_id",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "concept_id",
                "value": "",
