          "id": "398bad7e-c150-46f9-a1c7-1e4ccf222574",
          "name": "Get Detailed Video Search By Id",
          "request": {
            "name": "Get Detailed Video Search By Id",
            "description": {
              "content": "Retrieves composite slices (shots, scenes, etc.) within a specific video ranked by their similarity to a text query. Given a video_id and text_query, this endpoint performs a drill-down search to find moments within that video. The text query is encoded using the dataset's configured shot-level encoder (e.g., Perception Encoder or other vision-language embedding models), then searched against shot embeddings for that specific video. Returns a ranked list of composite slices ordered by similarity score, including timestamps (start_time_ms, end_time_ms), frame numbers, and representative keyframes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "search",
                "video"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dataset_id",
                  "value": "<string>",
                  "description": "(Required) Dataset identifier"
                },
                {
                  "disabled": false,
                  "key": "text_query",
                  "value": "<string>",
                  "description": "(Required) Text query for search"
                },
                {
                  "disabled": false,
                  "key": "video_id",
                  "value": "<string>",
                  "description": "(Required) Video identifier"
                },
                {
                  "disabled": false,
                  "key": "composite_type",
                  "value": "shot",
                  "description": "Type of composite"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of slices to return"
                }
              ],
              "variable": []
            },
            "header": [
